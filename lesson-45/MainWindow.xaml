<Window x:Class="Lesson45.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Заказ товара"
        Height="520"
        Width="480"
        MinHeight="500"
        MinWidth="400"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0"
                   Grid.Column="0"
                   Text="Имя:"
                   VerticalAlignment="Center"
                   Margin="0,0,15,12"/>
        <TextBox x:Name="NameTextBox"
                 Grid.Row="0"
                 Grid.Column="1"
                 Height="28"
                 VerticalContentAlignment="Center"
                 Margin="0,0,0,12"/>

        <TextBlock Grid.Row="1"
                   Grid.Column="0"
                   Text="Телефон:"
                   VerticalAlignment="Center"
                   Margin="0,0,15,15"/>
        <TextBox x:Name="PhoneTextBox"
                 Grid.Row="1"
                 Grid.Column="1"
                 Height="28"
                 MaxLength="15"
                 VerticalContentAlignment="Center"
                 Margin="0,0,0,15"
                 PreviewTextInput="PhoneTextBox_PreviewTextInput"
                 PreviewKeyDown="PhoneTextBox_PreviewKeyDown"
                 DataObject.Pasting="PhoneTextBox_Pasting"/>

        <TextBlock Grid.Row="2"
                   Grid.ColumnSpan="2"
                   Text="Способ оплаты:"
                   FontWeight="SemiBold"
                   Margin="0,0,0,6"/>
        <StackPanel Grid.Row="3"
                    Grid.ColumnSpan="2"
                    Orientation="Horizontal"
                    Margin="0,0,0,15">
            <RadioButton Content="Наличные" GroupName="PaymentGroup" Margin="0,0,20,0" Checked="PaymentRadioButton_Checked"/>
            <RadioButton Content="Карта" GroupName="PaymentGroup" Margin="0,0,20,0" Checked="PaymentRadioButton_Checked"/>
            <RadioButton Content="Онлайн" GroupName="PaymentGroup" Checked="PaymentRadioButton_Checked"/>
        </StackPanel>

        <TextBlock Grid.Row="4"
                   Grid.ColumnSpan="2"
                   Text="Дополнительно:"
                   FontWeight="SemiBold"
                   Margin="0,0,0,6"/>
        <StackPanel Grid.Row="5"
                    Grid.ColumnSpan="2"
                    Margin="0,0,0,15">
            <CheckBox x:Name="GiftCheckBox"
                      Content="Подарочная упаковка (+100₽)"
                      Margin="0,0,0,5"
                      Checked="ExtraCheckBox_Changed"
                      Unchecked="ExtraCheckBox_Changed"/>
            <CheckBox x:Name="ExpressCheckBox"
                      Content="Срочная доставка (+200₽)"
                      Checked="ExtraCheckBox_Changed"
                      Unchecked="ExtraCheckBox_Changed"/>
        </StackPanel>

        <Grid Grid.Row="6"
              Grid.ColumnSpan="2"
              Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="50"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0"
                       Text="Количество:"
                       VerticalAlignment="Center"
                       Margin="0,0,15,0"/>
            <Slider x:Name="QuantitySlider"
                    Grid.Column="1"
                    Minimum="1"
                    Maximum="10"
                    Value="1"
                    TickFrequency="1"
                    IsSnapToTickEnabled="True"
                    VerticalAlignment="Center"
                    ValueChanged="QuantitySlider_ValueChanged"/>
            <TextBlock x:Name="QuantityTextBlock"
                       Grid.Column="2"
                       Text="1 шт"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Right"/>
        </Grid>

        <TextBlock Grid.Row="7"
                   Grid.ColumnSpan="2"
                   x:Name="PriceInfoTextBlock"
                   Foreground="Gray"
                   Margin="0,0,0,6"/>

        <TextBlock x:Name="TotalTextBlock"
                   Grid.Row="8"
                   Grid.ColumnSpan="2"
                   FontSize="20"
                   FontWeight="Bold"
                   Margin="0,0,0,15"/>

        <Button x:Name="OrderButton"
                Grid.Row="9"
                Grid.ColumnSpan="2"
                Content="Оформить заказ"
                Height="40"
                FontSize="16"
                VerticalAlignment="Top"
                Click="OrderButton_Click"/>
    </Grid>
</Window>
