<Window x:Class="Lesson44.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Заказ пиццы"
        Height="580"
        Width="460"
        MinHeight="540"
        MinWidth="420"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0"
                   Grid.ColumnSpan="2"
                   Text="Заказ пиццы"
                   FontSize="24"
                   FontWeight="Bold"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,15"/>

        <TextBlock Grid.Row="1"
                   Grid.Column="0"
                   Text="Размер:"
                   FontWeight="SemiBold"
                   Margin="0,0,20,15"/>
        <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,15">
            <RadioButton x:Name="SmallRadioButton" GroupName="SizeGroup" Content="Маленькая" Margin="0,0,0,5"/>
            <RadioButton x:Name="MediumRadioButton" GroupName="SizeGroup" Content="Средняя" IsChecked="True" Margin="0,0,0,5"/>
            <RadioButton x:Name="LargeRadioButton" GroupName="SizeGroup" Content="Большая"/>
        </StackPanel>

        <TextBlock Grid.Row="2"
                   Grid.Column="0"
                   Text="Добавки:"
                   FontWeight="SemiBold"
                   Margin="0,0,20,15"/>
        <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,0,0,15">
            <CheckBox x:Name="CheeseCheckBox" Content="Сыр" Margin="0,0,0,5"/>
            <CheckBox x:Name="MushroomsCheckBox" Content="Грибы" Margin="0,0,0,5"/>
            <CheckBox x:Name="PepperoniCheckBox" Content="Пепперони"/>
        </StackPanel>

        <TextBlock Grid.Row="3"
                   Grid.Column="0"
                   Text="Количество:"
                   FontWeight="SemiBold"
                   VerticalAlignment="Center"
                   Margin="0,0,20,15"/>
        <Grid Grid.Row="3" Grid.Column="1" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Slider x:Name="QuantitySlider"
                    Grid.Column="0"
                    Minimum="1"
                    Maximum="10"
                    Value="1"
                    TickFrequency="1"
                    TickPlacement="BottomRight"
                    IsSnapToTickEnabled="True"
                    VerticalAlignment="Center"/>
            <TextBlock Grid.Column="1"
                       Text="{Binding ElementName=QuantitySlider, Path=Value, StringFormat=N0}"
                       FontWeight="Bold"
                       VerticalAlignment="Center"
                       Margin="10,0,5,0"/>
            <TextBlock Grid.Column="2"
                       Text="штук"
                       VerticalAlignment="Center"/>
        </Grid>

        <TextBlock Grid.Row="4"
                   Grid.ColumnSpan="2"
                   Text="Комментарий к заказу:"
                   FontWeight="SemiBold"
                   Margin="0,0,0,5"/>
        <TextBox x:Name="CommentTextBox"
                 Grid.Row="5"
                 Grid.ColumnSpan="2"
                 MinHeight="80"
                 MaxLength="200"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto"
                 Margin="0,0,0,15"/>

        <Button x:Name="OrderButton"
                Grid.Row="6"
                Grid.ColumnSpan="2"
                Content="Оформить заказ"
                Height="40"
                FontSize="16"
                Click="OrderButton_Click"/>
    </Grid>
</Window>
