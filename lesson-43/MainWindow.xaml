<Window x:Class="Lesson43.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Макет приложения"
        Height="450"
        Width="800"
        MinHeight="350"
        MinWidth="600"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Row="0"
                Grid.Column="0"
                Margin="10,10,5,5"
                Padding="10"
                BorderBrush="Gray"
                BorderThickness="1"
                CornerRadius="6">
            <TextBlock Text="Название программы"
                       FontSize="18"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>
        </Border>

        <Border Grid.Row="1"
                Grid.Column="0"
                Margin="10,5,5,10"
                BorderBrush="Gray"
                BorderThickness="1"
                CornerRadius="6">
            <StackPanel Width="170"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Margin="0,10">
                <Button Content="Главная" Height="36" Margin="0,5"/>
                <Button Content="Каталог" Height="36" Margin="0,5"/>
                <Button Content="Настройки" Height="36" Margin="0,5"/>
                <Button Content="О программе" Height="36" Margin="0,5"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="0"
                Grid.Column="1"
                Grid.RowSpan="2"
                Margin="5,10,10,10"
                BorderBrush="Gray"
                BorderThickness="1"
                CornerRadius="6">
            <Image Source="/Images/Landscape.png"
                   Stretch="Uniform"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Margin="20"/>
        </Border>
    </Grid>
</Window>
