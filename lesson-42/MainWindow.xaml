<Window x:Class="Lesson42.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Калькулятор"
        Height="400"
        Width="360"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <StackPanel Margin="20">
            <TextBlock Text="Первое число:" Margin="0,0,0,5"/>
            <TextBox x:Name="FirstNumberTextBox" Height="28" FontSize="16" VerticalContentAlignment="Center" Margin="0,0,0,12"/>

            <TextBlock Text="Действие:" Margin="0,0,0,5"/>
            <ComboBox x:Name="OperationComboBox" Height="28" FontSize="16" Margin="0,0,0,12"/>

            <TextBlock Text="Второе число:" Margin="0,0,0,5"/>
            <TextBox x:Name="SecondNumberTextBox" Height="28" FontSize="16" VerticalContentAlignment="Center" Margin="0,0,0,16"/>

            <Button x:Name="CalculateButton" Content="Вычислить" Height="34" FontSize="16" Click="CalculateButton_Click" Margin="0,0,0,16"/>

            <TextBlock Text="Результат:" Margin="0,0,0,5"/>
            <TextBox x:Name="ResultTextBox" Height="28" FontSize="16" IsReadOnly="True" VerticalContentAlignment="Center"/>
        </StackPanel>
    </Grid>
</Window>
